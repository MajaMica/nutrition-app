generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Food {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?  @map("name_en")
  category    String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  sugar       Float?
  salt        Float?   
  saturatedFat Float?  @map("saturated_fat") 
  icon        String?
  allergens   String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ingredients RecipeIngredient[]

  @@index([name])
  @@index([category])
  @@map("foods")
}

model Recipe {
  id            String   @id @default(uuid())
  title         String
  titleEn       String?  @map("title_en")
  description   String?
  descriptionEn String?  @map("description_en")
  image         String?
  mealType      String   @map("meal_type")
  mealTypes     String[] @default([]) @map("meal_types")
  dietType      String?  @map("diet_type")
  dietTypes     String[] @default([]) @map("diet_types")
  difficulty    String?
  prepTime      Int?     @map("prep_time")
  servings      Int      @default(1)
  calories      Float    @default(0)
  protein       Float    @default(0)
  carbs         Float    @default(0)
  fat           Float    @default(0)
  fiber         Float    @default(0) 
  salt          Float    @default(0) 
  saturatedFat  Float    @default(0) @map("saturated_fat") 
  isPremium     Boolean  @default(false) @map("is_premium")
  isPublished   Boolean  @default(true) @map("is_published")
  ingredients   RecipeIngredient[]
  steps         RecipeStep[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([mealType])
  @@index([dietType])
  @@index([isPremium])
  @@map("recipes")
}

model RecipeIngredient {
  id       String  @id @default(uuid())
  recipeId String  @map("recipe_id")
  foodId   String  @map("food_id")
  amount   Float
  unit     String  @default("g")
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food     Food    @relation(fields: [foodId], references: [id])

  @@map("recipe_ingredients")
}

model RecipeStep {
  id       String  @id @default(uuid())
  recipeId String  @map("recipe_id")
  order    Int
  text     String
  textEn   String? @map("text_en")
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_steps")
}

model User {
  id              String   @id
  email           String   @unique
  name            String?
  birthYear       Int?     @map("birth_year")
  gender          String?
  height          Int?
  weight          Float?
  targetWeight    Float?   @map("target_weight")
  activityLevel   String?  @map("activity_level")
  goal            String?
  dietType        String?  @map("diet_type")
  allergies       String[] @default([])
  dislikedFoods   String[] @default([]) @map("disliked_foods")
  onboardingDone  Boolean  @default(false) @map("onboarding_done")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
}